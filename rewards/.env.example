MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
BILLING_ENFORCE_SUBSCRIPTION=0

WALLET_SYNC_ENABLED=0
WALLET_SERVICE_URL=
